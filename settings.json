{
    "display": {
        "type": "hdmi-desktop",
        "ili9486": {
            "dc_pin": 24,
            "reset_pin": 25,
            "spi_bus": 0,
            "spi_device": 0,
            "spi_speed": 16000000
        },
        "hdmi-pygame": {
            "fullscreen": true,
            "window_width": 800,
            "window_height": 480
        },
        "hdmi-desktop": {
            "fullscreen": true,
            "scale": 1
        }
    },
    "custard_cream": {
        "api_key_env": "GOOGLE_API_KEY",
        "transcribe_model": "gemini-2.5-flash",
        "edit_model": "gemini-2.5-flash-image",
        "sample_rate": 16000,
        "channels": 1,
        "max_record_seconds": 15,
        "result_hold_seconds": 4,
        "device": null
    },
    "shutter_remote": {
        "enabled": true,
        "photo_key": "KEY_VOLUMEUP",
        "speak_key": "KEY_ENTER",
        "device_name": null,
        "grab": true
    },
    "printing": {
        "printer": "SELPHY_CP400",
        "test_mode": true,
        "test_folder": "print_tests"
    },
    "camera": {
        "hflip": true,
        "vflip": true
    },
    "watermark": {
        "enabled": true,
        "file": "assets/images/watermark.png",
        "horizontal_align": "right",
        "vertical_align": "bottom",
        "width_fraction": 0.2,
        "margin_fraction": 0.02
    },
    "datestamp": {
        "enabled": true,
        "format": "%Y-%m-%d %H:%M",
        "horizontal_align": "left",
        "vertical_align": "bottom",
        "font_fraction": 0.035,
        "margin_fraction": 0.02,
        "text_colour": [255, 255, 255, 255],
        "background_colour": [0, 0, 0, 140]
    },
    "publish": {
        "type": "flickr",
        "flickr": {
            "api_key_env": "FLICKR_API_KEY",
            "api_secret_env": "FLICKR_API_SECRET",
            "tags": "custardcreamcamera",
            "is_public": true,
            "token_cache_dir": null
        }
    }
}
