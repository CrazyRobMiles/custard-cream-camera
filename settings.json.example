{
    "mode": "camera",
    "display": {
        "type": "hdmi-desktop",
        "width": 800,
        "height": 480,
        "hdmi-desktop": {
            "fullscreen": true,
            "scale": 1
        }
    },
    "custard_cream": {
        "api_key_env": "GOOGLE_API_KEY",
        "transcribe_provider": "vosk",
        "transcribe_model": "gemini-3.5-flash",
        "edit_model": "gemini-3.1-flash-image",
        "sample_rate": 16000,
        "channels": 1,
        "max_record_seconds": 15,
        "result_hold_seconds": 4,
        "device": null,
        "timeout_seconds": 30,
        "vosk": {
            "model_path": "models/vosk-model-small-en-us-0.15"
        }
    },
    "ai_edit": {
        "enabled": true,
        "input_method": "voice",
        "presets": [
            "Make it look like a watercolor painting",
            "Turn it into a black-and-white film noir photo",
            "Add a retro polaroid-style border",
            "Make it look like a comic book illustration"
        ]
    },
    "camera": {
        "hflip": false,
        "vflip": false
    },
    "exposure": {
        "default": 0.0,
        "step": 0.5,
        "min": -2.0,
        "max": 2.0
    },
    "shutter_remote": {
        "enabled": false,
        "photo_key": "KEY_VOLUMEUP",
        "speak_key": "KEY_ENTER",
        "device_name": "AB Shutter3",
        "grab": true
    },
    "serial_remote": {
        "enabled": false,
        "port": "/dev/ttyUSB0",
        "baud_rate": 115200
    },
    "audio_output": {
        "enabled": true,
        "device": null,
        "shutter_sound": "assets/audio/shutter.wav"
    },
    "ftp": {
        "host": "0.0.0.0",
        "port": 2121,
        "username": "sony",
        "password": "changeme",
        "incoming_dir": "ftp_incoming"
    },
    "printing": {
        "printer": null,
        "test_mode": false,
        "test_folder": "print_tests",
        "job_timeout_seconds": 120
    },
    "watermark": {
        "enabled": true,
        "file": "assets/images/watermark.png",
        "horizontal_align": "right",
        "vertical_align": "bottom",
        "width_fraction": 0.2,
        "margin_fraction": 0.02
    },
    "datestamp": {
        "enabled": true,
        "format": "%Y-%m-%d %H:%M",
        "horizontal_align": "left",
        "vertical_align": "bottom",
        "font_fraction": 0.035,
        "margin_fraction": 0.02,
        "text_colour": [255, 255, 255, 255],
        "background_colour": [0, 0, 0, 140]
    },
    "publish": {
        "flickr": {
            "enabled": true,
            "api_key_env": "FLICKR_API_KEY",
            "api_secret_env": "FLICKR_API_SECRET",
            "tags": "custardcreamcamera",
            "is_public": true,
            "token_cache_dir": null
        },
        "bsky": {
            "enabled": true,
            "handle_env": "BSKY_HANDLE",
            "app_password_env": "BSKY_APP_PASSWORD",
            "text": "",
            "alt_text": ""
        },
        "custard_cream_server": {
            "enabled": true,
            "base_url": "https://custardcream.cam/",
            "email_env": "CUSTARD_CREAM_SERVER_EMAIL",
            "password_env": "CUSTARD_CREAM_SERVER_PASSWORD",
            "tags": "custardcreamcamera"
        }
    }
}
